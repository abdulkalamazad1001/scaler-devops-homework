{
  "uid": "campusdesk", "title": "CampusDesk / Service Health", "schemaVersion": 39,
  "version": 1, "refresh": "10s", "time": {"from": "now-30m", "to": "now"},
  "tags": ["campusdesk", "24BCS10053"],
  "panels": [
    {"id": 1, "title": "Healthy backend replicas", "type": "stat", "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(up{job=\"campusdesk\"})", "refId": "A"}]},
    {"id": 2, "title": "Requests per second", "type": "stat", "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(campusdesk_http_requests_total[5m]))", "refId": "A"}], "fieldConfig": {"defaults": {"decimals": 2}}},
    {"id": 3, "title": "P95 request duration", "type": "stat", "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(campusdesk_http_request_duration_seconds_bucket[5m])))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 4, "title": "HTTP traffic by route", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (route) (rate(campusdesk_http_requests_total[2m]))", "legendFormat": "{{route}}", "refId": "A"}]},
    {"id": 5, "title": "Responses by status code", "type": "timeseries", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (status) (rate(campusdesk_http_requests_total[2m]))", "legendFormat": "{{status}}", "refId": "A"}]}
  ]
}
