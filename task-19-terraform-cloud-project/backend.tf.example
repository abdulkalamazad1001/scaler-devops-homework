# Remote state in S3. To use it: create the bucket (and lock table) once,
# copy this file to backend.tf, then run `terraform init -migrate-state`.
#
# Terraform 1.9.x locks S3 state with a DynamoDB table (partition key "LockID",
# type String). From Terraform 1.11 the S3 backend can lock with a lock file in
# the bucket instead: replace dynamodb_table with `use_lockfile = true`.

terraform {
  backend "s3" {
    bucket         = "devops-student-tfstate-123456789012"
    key            = "task-19-terraform-cloud-project/terraform.tfstate"
    region         = "ap-south-1"
    encrypt        = true
    dynamodb_table = "terraform-locks"
  }
}
