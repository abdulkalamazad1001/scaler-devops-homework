# Copy to terraform.tfvars (git-ignored) and adjust. No credentials go here:
# Terraform reads them from the AWS CLI profile or environment variables.
aws_region          = "ap-south-1"
project             = "taskboard"
environment         = "dev"
cluster_name        = "taskboard-eks"
kubernetes_version  = "1.33"
vpc_cidr            = "10.20.0.0/16"
az_count            = 2
node_instance_types = ["t3.medium"]
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4
api_allowed_cidrs   = ["203.0.113.10/32"]
